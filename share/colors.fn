# share/colors.fn — ANSI color constants with NO_COLOR support
#
# Exports: COLOR_RESET, COLOR_BOLD, COLOR_DIM, COLOR_RED, COLOR_GREEN,
#          COLOR_YELLOW, COLOR_BLUE, COLOR_CYAN, COLOR_MAGENTA
#          color_enabled() -> 0 (enabled) | 1 (disabled)
#
# Sets color constants at source time.  color_enabled() checks both
# NO_COLOR and CLICOLOR environment variables for runtime queries.
#
# This file is safe under set -e (no exit, no bare commands).

if [[ -z "${NO_COLOR:-}" ]] && [[ -t 1 ]]; then
  COLOR_RESET="\e[0m";  COLOR_BOLD="\e[1m";   COLOR_DIM="\e[2m"
  COLOR_RED="\e[31m";   COLOR_GREEN="\e[32m"; COLOR_YELLOW="\e[33m"
  COLOR_BLUE="\e[34m";  COLOR_CYAN="\e[36m";  COLOR_MAGENTA="\e[35m"
else
  COLOR_RESET=""; COLOR_BOLD=""; COLOR_DIM=""
  COLOR_RED="";  COLOR_GREEN=""; COLOR_YELLOW=""
  COLOR_BLUE=""; COLOR_CYAN="";  COLOR_MAGENTA=""
fi

# Runtime check — use when NO_COLOR may be set after source time
color_enabled() {
  [[ -z "${NO_COLOR:-}" ]] && [[ -t 1 ]]
}
