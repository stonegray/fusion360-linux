# share/traps.fn — Signal trap management
#
# Exports: setup_traps(), clear_traps(), cleanup_temp_files()
#
# Safe under set -e.

# Register cleanup handlers for common signals
setup_traps() {
  local cleanup_func="${1:-cleanup}"
  trap "$cleanup_func" EXIT INT TERM
}

# Remove signal traps
clear_traps() {
trap - EXIT INT TERM
}

# Remove mktemp-allocated temporary directories
cleanup_temp_files() {
  [[ -n "${FUSION_TEMP_DIR:-}" ]] && rm -rf "$FUSION_TEMP_DIR" || true
}
