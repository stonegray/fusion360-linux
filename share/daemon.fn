# share/daemon.fn — Background daemon lifecycle for Fusion 360
#
# Sources: share/paths.fn, share/log.fn
# Exports: start_browser_listener(), start_overlay_killer(),
#          start_toolwindow_fixer(), stop_all_daemons()
#
# Expects the following env vars to be set externally (e.g. by load_config
# or launch context):
#   BROWSER_LISTENER, FUSION_OVERLAY_KILLER, FUSION_TOOLWINDOW_FIXER,
#   FUSION_ENABLE_OVERLAY_KILLER, FUSION_ENABLE_TOOLWINDOW_FIXER,
#   FUSION_OVERLAY_SIZE_TOLERANCE_PERCENT, PROTON, STEAM_COMPAT_DATA_PATH
#
# Safe under set -e.

# ── Private helpers ────────────────────────────────────────────────────

# Check if a boolean config option is enabled (1/yes/true/on/enabled/y)
_is_enabled() {
  is_enabled "$@"
}

# ── Daemon PID tracking variables ──────────────────────────────────────
BRIDGE_LISTENER_PID=""
OVERLAY_KILLER_PID=""
TOOLWINDOW_FIXER_PID=""

# ── PID file helpers ──────────────────────────────────────────────────

# Write a PID file at $FUSION_PID_DIR/<name>.pid
daemon_write_pid() {
  local name="${1:?daemon_write_pid: missing name}"
  mkdir -p "$FUSION_PID_DIR"
  printf "%s\n" "$2" > "$FUSION_PID_DIR/$name.pid"
}

# Check if a daemon is already running via its PID file.
# Returns 0 (running) or 1 (not running).
daemon_check_running() {
  local name="${1:?daemon_check_running: missing name}"
  local pid_file="$FUSION_PID_DIR/$name.pid"
  [[ -f "$pid_file" ]] || return 1
  local pid
  pid="$(cat "$pid_file" 2>/dev/null || echo '')"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

# Remove PID file for a daemon
daemon_remove_pid() {
  local name="${1:?daemon_remove_pid: missing name}"
  rm -f "$FUSION_PID_DIR/$name.pid"
}

# Clean up all PID files on exit
daemon_cleanup_all_pids() {
  rm -rf "$FUSION_PID_DIR" 2>/dev/null || true
}

# ── Browser bridge listener ────────────────────────────────────────────
# Start the browser bridge listener in background (nohup).
# Clears stale bridge temp files first, then launches the listener.
start_browser_listener() {
  daemon_check_running "browser-listener" && { log_info "Browser listener already running"; return 0; }
  [[ -x "$BROWSER_LISTENER" ]] || { log_error "Browser listener not found or not executable: $BROWSER_LISTENER"; return 1; }

  clear_bridge_temp_files || true

  (nohup setsid "$BROWSER_LISTENER" &) &>/dev/null
  BRIDGE_LISTENER_PID=$!
  disown 2>/dev/null || true
  daemon_write_pid "browser-listener" "$BRIDGE_LISTENER_PID"
  log_info "Browser listener started (PID $BRIDGE_LISTENER_PID)"
}

# ── Gray overlay killer ────────────────────────────────────────────────
# Start the gray overlay killer daemon in background.
# Passes FUSION_ENABLE_OVERLAY_KILLER and FUSION_OVERLAY_SIZE_TOLERANCE_PERCENT
# as env vars to the child process.
start_overlay_killer() {
  _is_enabled "$FUSION_ENABLE_OVERLAY_KILLER" || return 0
  daemon_check_running "overlay-killer" && { log_info "Overlay killer already running"; return 0; }

  if [[ ! -x "$FUSION_OVERLAY_KILLER" ]]; then
    log_warn "Overlay killer is enabled but not executable: $FUSION_OVERLAY_KILLER"
    return 0
  fi

  (nohup setsid env FUSION_OVERLAY_SIZE_TOLERANCE_PERCENT="$FUSION_OVERLAY_SIZE_TOLERANCE_PERCENT" \
    "$FUSION_OVERLAY_KILLER" &) &>/dev/null
  OVERLAY_KILLER_PID=$!
  disown 2>/dev/null || true
  daemon_write_pid "overlay-killer" "$OVERLAY_KILLER_PID"
  log_info "Overlay killer started (PID $OVERLAY_KILLER_PID)"
}

# ── Toolwindow fixer ───────────────────────────────────────────────────
# Background daemon that adds WS_EX_APPWINDOW to Fusion's docked
# toolwindow popups so Wine's X11 driver makes them "managed" instead
# of override-redirect.  Fixes the "always on top" z-order bug.
start_toolwindow_fixer() {
  _is_enabled "$FUSION_ENABLE_TOOLWINDOW_FIXER" || return 0
  daemon_check_running "toolwindow-fixer" && { log_info "Toolwindow fixer already running"; return 0; }

  if [[ ! -x "$FUSION_TOOLWINDOW_FIXER" ]]; then
    log_warn "Toolwindow fixer is enabled but not executable: $FUSION_TOOLWINDOW_FIXER"
    return 0
  fi

  # Find the Wine binary from the GE-Proton installation
  if [[ -z "${PROTON:-}" ]]; then
    log_warn "PROTON is not set — cannot find Wine binary for toolwindow fixer"
    return 0
  fi
  local wine_bin
  wine_bin="$(proton_wine_bin "$PROTON")"
  if [[ ! -x "$wine_bin" ]]; then
    log_warn "Wine binary not found at $wine_bin"
    return 0
  fi

  (nohup setsid env WINEPREFIX="${STEAM_COMPAT_DATA_PATH:-${PFX_DIR:-$HOME/.fusion360-proton2}}/pfx" \
    "$wine_bin" "$FUSION_TOOLWINDOW_FIXER" &) &>/dev/null
  TOOLWINDOW_FIXER_PID=$!
  disown 2>/dev/null || true
  daemon_write_pid "toolwindow-fixer" "$TOOLWINDOW_FIXER_PID"
  log_info "Toolwindow fixer started (PID $TOOLWINDOW_FIXER_PID)"
}

# ── Stop all tracked daemons ───────────────────────────────────────────
stop_all_daemons() {
  if [[ -n "$OVERLAY_KILLER_PID" ]]; then
    if kill -0 "$OVERLAY_KILLER_PID" 2>/dev/null; then
      kill "$OVERLAY_KILLER_PID" 2>/dev/null || true
      wait "$OVERLAY_KILLER_PID" 2>/dev/null || true
    fi
    OVERLAY_KILLER_PID=""
  fi

  if [[ -n "$BRIDGE_LISTENER_PID" ]]; then
    if kill -0 "$BRIDGE_LISTENER_PID" 2>/dev/null; then
      kill "$BRIDGE_LISTENER_PID" 2>/dev/null || true
      wait "$BRIDGE_LISTENER_PID" 2>/dev/null || true
    fi
    BRIDGE_LISTENER_PID=""
  fi

  if [[ -n "$TOOLWINDOW_FIXER_PID" ]]; then
    if kill -0 "$TOOLWINDOW_FIXER_PID" 2>/dev/null; then
      kill "$TOOLWINDOW_FIXER_PID" 2>/dev/null || true
      wait "$TOOLWINDOW_FIXER_PID" 2>/dev/null || true
    fi
    TOOLWINDOW_FIXER_PID=""
  fi
}

# ── Health check — auto-restart dead daemons ─────────────────────────
# Check tracked daemons and restart any that have died.
# Called periodically from the launcher or a cron-style loop.
# Returns the number of daemons that were restarted (0-3).
daemon_health_check() {
  local changes=0
  if ! daemon_check_running "browser-listener" && [[ -x "$BROWSER_LISTENER" ]]; then
    log_warn "Browser listener died — restarting"
    start_browser_listener
    changes=1
  fi
  if ! daemon_check_running "overlay-killer" && [[ -x "$FUSION_OVERLAY_KILLER" ]]; then
    log_warn "Overlay killer died — restarting"
    start_overlay_killer
    changes=1
  fi
  if ! daemon_check_running "toolwindow-fixer" && [[ -x "$FUSION_TOOLWINDOW_FIXER" ]]; then
    log_warn "Toolwindow fixer died — restarting"
    start_toolwindow_fixer
    changes=1
  fi
  return "$changes"
}
