# share/proton.fn — Proton discovery and Wine binary derivation
#
# Sources: share/paths.fn
# Exports: find_proton(), proton_wine_bin(), detect_proton_version()
#
# Safe under set -e.

# Search COMPAT_DIR for the 'proton' binary.  Returns the first match
# (or empty string if none found).  Used in many installer scripts that
# need to locate GE-Proton.
find_proton() {
  local compat_dir="${1:-$COMPAT_DIR}"
  find "$compat_dir" -name proton -type f 2>/dev/null | head -1 || true
}

# The Proton the launcher actually runs: PROTON from the user config (parsed
# the same way load_config does), else $PROTON, else the launcher's default
# path. Unlike find_proton it never picks an arbitrary other release.
# Usage: proton=$(configured_proton [config_file]) || ...
configured_proton() {
  local cfg="${1:-${XDG_CONFIG_HOME:-$HOME/.config}/fusion360-linux/config}"
  local p
  p="$(
    if [[ -f "$cfg" ]] && declare -F parse_config >/dev/null; then
      parse_config "$cfg" >/dev/null 2>&1 || true
    fi
    printf '%s' "${PROTON:-$HOME/.local/share/Steam/compatibilitytools.d/${GE_PROTON_VERSION:-GE-Proton11-3}/proton}"
  )"
  [[ -f "$p" ]] || return 1
  printf '%s\n' "$p"
}

# Given a proton binary path, derive the Wine binary location.
# Proton ships its own Wine inside the bundle under files/bin/.
# Usage: wine_bin=$(proton_wine_bin "$proton")
proton_wine_bin() {
  local proton="${1:?proton_wine_bin: missing proton path}"
  local dir
  dir="$(dirname "$proton" 2>/dev/null)" || return 1
  printf "%s" "$dir/files/bin/wine"
}

# Detect Proton version from the parent directory name.
# GE-Proton installations are named by version, e.g.
# /path/to/GE-Proton11-3/proton → "GE-Proton11-3".
# Falls back to "unknown" on failure.
detect_proton_version() {
  local proton="${1:?detect_proton_version: missing proton path}"
  local dir
  dir="$(dirname "$(readlink -f "$proton")" 2>/dev/null)" || { echo "unknown"; return 1; }
  basename "$dir" 2>/dev/null || echo "unknown"
}
